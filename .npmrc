# The Expo 57 dependency tree carries a peer conflict it cannot resolve on its
# own: expo-router pulls react-native-reanimated 4.5.1, which peers on
# react-native-worklets 0.10.x, and npm's strict peer resolution refuses the
# tree rather than picking one.
#
# Set here rather than left as a flag people have to remember, because without
# it the first command in RUNNING.md fails — `npm install` on a clean checkout
# errors out with ERESOLVE, which reads as "this project is broken" to whoever
# is trying it for the first time.
legacy-peer-deps=true
